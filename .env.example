# =============================================================================
# FG DRIVO MOBILITY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit .env to source control).
# 2. Paste your Google Cloud restricted API keys into the corresponding fields.
# 3. Restrict your client key by HTTP Referrer in Google Cloud Console:
#    https://console.cloud.google.com/google/maps-apis/credentials
# =============================================================================

# --- CLIENT-SIDE MAPS CONFIGURATION (Browser) ---
# MUST be restricted in Google Cloud Console to:
# - Application restriction: HTTP referrers (e.g., http://localhost:3000/*, https://yourdomain.com/*)
# - API restrictions: Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=

# --- SERVER-SIDE MAPS CONFIGURATION (Backend Only) ---
# MUST be kept secret on the server; NEVER exposed to client-side bundles.
# Restrict in Google Cloud Console to:
# - Application restriction: IP addresses (your server IP)
# - API restrictions: Geocoding API, Routes API, Places API (New)
GOOGLE_MAPS_SERVER_API_KEY=

# --- CLIENT-SIDE API CONFIGURATION ---
# Leave blank for local web development (auto-detects origin/port 5000)
# Set to LAN IP (e.g., http://192.168.1.X:5000) for testing on physical Android phones
# Set to production cloud domain (e.g., https://api.fgdrivo.com) for Play Store releases
VITE_API_URL=

# --- SERVER PORT & HOST ---
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# --- THIRD-PARTY PRODUCTION GATEWAYS ---
# SMS OTP Gateway (Fast2SMS / Twilio)
SMS_GATEWAY_PROVIDER=mock
SMS_API_KEY=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Authentication (Free 10,000 SMS/month Google Phone Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Push Notifications (Optional path or use android/app/google-services.json)
FIREBASE_SERVICE_ACCOUNT_PATH=
